diff --git a/app/Services/LegacyAnalysisService.php b/app/Services/LegacyAnalysisService.php
new file mode 100644
index 0000000..d87042b
--- /dev/null
+++ b/app/Services/LegacyAnalysisService.php
@@ -0,0 +1,118 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use Carbon\CarbonImmutable;
+use Illuminate\Validation\ValidationException;
+
+final class LegacyAnalysisService
+{
+    public function __construct(private readonly LegacySqlSnapshotParser $parser) {}
+
+    /**
+     * @return array<string, mixed>
+     */
+    public function analyze(string $path, string $from, string $to): array
+    {
+        $start = CarbonImmutable::parse($from)->startOfDay();
+        $end = CarbonImmutable::parse($to)->endOfDay();
+        if ($start->greaterThan($end)) {
+            throw ValidationException::withMessages(['documents_from' => 'The start date must be before the end date.']);
+        }
+
+        $snapshot = $this->parser->parse($path);
+        $purchaseDetails = collect($snapshot['details_buy'])->groupBy(fn (array $row): string => (string) ($row['id_buy'] ?? ''));
+        $salesDetails = collect($snapshot['details_sales'])->groupBy(fn (array $row): string => (string) ($row['id_sales'] ?? ''));
+        $purchases = collect($snapshot['buy'])->filter(fn (array $row): bool => $this->inRange($row['date'] ?? null, $start, $end));
+        $sales = collect($snapshot['sales'])->filter(fn (array $row): bool => $this->inRange($row['insert_date'] ?? null, $start, $end));
+        $paymentPurchases = $purchases->filter(fn (array $row): bool => $this->isPaymentRow($row));
+        $paymentSales = $sales->filter(fn (array $row): bool => $this->isPaymentRow($row));
+
+        $purchaseClassified = $purchases->filter(function (array $row) use ($purchaseDetails): bool {
+            $details = $purchaseDetails->get((string) ($row['id_buy'] ?? ''), collect());
+
+            return $details->isNotEmpty() && ! empty($row['id_import']) && ! empty($row['id_stores']) && ! empty($row['id_type']);
+        });
+        $salesClassified = $sales->filter(function (array $row) use ($salesDetails): bool {
+            $details = $salesDetails->get((string) ($row['id_sales'] ?? ''), collect());
+
+            return $details->isNotEmpty() && ! empty($row['id_customer']) && ! empty($row['id_stores']);
+        });
+
+        return [
+            'range' => ['from' => $start->toDateString(), 'to' => $end->toDateString()],
+            'source_tables' => collect($snapshot)->map(fn (array $rows): int => count($rows))->all(),
+            'master_counts' => [
+                'customers' => count($snapshot['customer']),
+                'suppliers' => count($snapshot['import']),
+                'product_types' => count($snapshot['type_mm']),
+                'categories' => count($snapshot['categories']),
+                'stores' => count($snapshot['stores']),
+            ],
+            'documents' => [
+                'purchase_candidates' => $purchaseClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->count(),
+                'purchase_candidate_lines' => $purchaseClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->sum(fn (array $row): int => $purchaseDetails->get((string) ($row['id_buy'] ?? ''), collect())->count()),
+                'purchase_needs_review' => $purchases->reject(fn (array $row): bool => $this->isPaymentRow($row))->count() - $purchaseClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->count(),
+                'sales_candidates' => $salesClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->count(),
+                'sales_candidate_lines' => $salesClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->sum(fn (array $row): int => $salesDetails->get((string) ($row['id_sales'] ?? ''), collect())->count()),
+                'sales_needs_review' => $sales->reject(fn (array $row): bool => $this->isPaymentRow($row))->count() - $salesClassified->reject(fn (array $row): bool => $this->isPaymentRow($row))->count(),
+                'receipt_candidates' => $paymentSales->count(),
+                'payment_candidates' => $paymentPurchases->count(),
+                'expense_candidates' => collect($snapshot['all_expenses'])->filter(fn (array $row): bool => $this->inRange($row['insert_date'] ?? null, $start, $end))->count(),
+                'bank_operation_candidates' => collect($snapshot['bank_operations'])->filter(fn (array $row): bool => $this->inRange($row['inserted_date'] ?? null, $start, $end))->count(),
+            ],
+            'samples' => [
+                'purchase_review' => $purchases->reject(fn (array $row): bool => $purchaseClassified->contains('id_buy', $row['id_buy'] ?? null))->take(10)->values()->all(),
+                'sales_review' => $sales->reject(fn (array $row): bool => $salesClassified->contains('id_sales', $row['id_sales'] ?? null))->take(10)->values()->all(),
+            ],
+            'warnings' => $this->warnings($snapshot, $purchases, $sales),
+        ];
+    }
+
+    private function inRange(mixed $value, CarbonImmutable $start, CarbonImmutable $end): bool
+    {
+        if ($value === null || trim((string) $value) === '') {
+            return false;
+        }
+        try {
+            $date = CarbonImmutable::parse((string) $value);
+        } catch (\Throwable) {
+            return false;
+        }
+
+        return $date->betweenIncluded($start, $end);
+    }
+
+    private function isPaymentRow(array $row): bool
+    {
+        return str_contains((string) ($row['bayan'] ?? ''), 'دفعة');
+    }
+
+    /** @return list<string> */
+    private function warnings(array $snapshot, $purchases, $sales): array
+    {
+        $warnings = [];
+        $mixedPurchases = $purchases->filter(fn (array $row): bool => empty($row['id_stores']) || empty($row['id_type']))->count();
+        $mixedSales = $sales->filter(fn (array $row): bool => empty($row['id_customer']) || empty($row['id_stores']))->count();
+        if ($mixedPurchases > 0) {
+            $warnings[] = "{$mixedPurchases} purchase records need manual classification.";
+        }
+        if ($mixedSales > 0) {
+            $warnings[] = "{$mixedSales} sales records need manual classification.";
+        }
+        $nonSteel = collect($snapshot['categories'])->filter(fn (array $row): bool => ! is_numeric($row['categories'] ?? null))->count();
+        if ($nonSteel > 0) {
+            $warnings[] = 'The legacy category table mixes diameters with non-steel items; item units and diameter applicability require review.';
+        }
+        if (collect($snapshot['all_expenses'])->isNotEmpty()) {
+            $warnings[] = 'Legacy expenses are staged for review only; each expense requires an explicit target expense account and payment source before posting.';
+        }
+        if (collect($snapshot['bank_operations'])->isNotEmpty()) {
+            $warnings[] = 'Legacy bank operations are analyzed as review evidence only; automatic posting is disabled until each operation is classified as a receipt, payment, or transfer.';
+        }
+
+        return $warnings;
+    }
+}
diff --git a/app/Services/LegacySqlSnapshotParser.php b/app/Services/LegacySqlSnapshotParser.php
new file mode 100644
index 0000000..2289e3b
--- /dev/null
+++ b/app/Services/LegacySqlSnapshotParser.php
@@ -0,0 +1,204 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use RuntimeException;
+
+final class LegacySqlSnapshotParser
+{
+    private const MAX_UNCOMPRESSED_BYTES = 268435456;
+
+    /** @var list<string> */
+    public const ALLOWED_TABLES = [
+        'customer', 'import', 'categories', 'type_mm', 'stores', 'buy', 'details_buy', 'sales', 'details_sales',
+        'store', 'name_treasury', 'treasury', 'name_bank', 'bank_accounts', 'bank_operations', 'all_expenses',
+    ];
+
+    /**
+     * @return array<string, list<array<string, mixed>>>
+     */
+    public function parse(string $path): array
+    {
+        if (! is_file($path) || ! is_readable($path)) {
+            throw new RuntimeException('The legacy source file cannot be read.');
+        }
+        if (! str_ends_with(strtolower($path), '.gz') && filesize($path) > self::MAX_UNCOMPRESSED_BYTES) {
+            throw new RuntimeException('The legacy source file is too large.');
+        }
+
+        $sql = str_ends_with(strtolower($path), '.gz')
+            ? $this->readGzip($path)
+            : file_get_contents($path);
+        if ($sql === false) {
+            throw new RuntimeException('The legacy source file could not be read.');
+        }
+        $tables = array_fill_keys(self::ALLOWED_TABLES, []);
+        $pattern = '/INSERT\\s+INTO\\s+`([^`]+)`\\s*\\((.*?)\\)\\s*VALUES\\s*(.*?);/is';
+
+        preg_match_all($pattern, $sql, $matches, PREG_SET_ORDER);
+        foreach ($matches as $match) {
+            $table = strtolower($match[1]);
+            if (! in_array($table, self::ALLOWED_TABLES, true)) {
+                continue;
+            }
+            $columns = array_map(fn (string $column): string => trim($column, " `\t\r\n"), $this->splitFields($match[2]));
+            foreach ($this->parseRows($match[3]) as $values) {
+                if (count($columns) !== count($values)) {
+                    continue;
+                }
+                $tables[$table][] = array_combine($columns, $values);
+            }
+        }
+
+        return $tables;
+    }
+
+    private function readGzip(string $path): string
+    {
+        $handle = gzopen($path, 'rb');
+        if ($handle === false) {
+            throw new RuntimeException('The compressed legacy source file cannot be opened.');
+        }
+        $contents = '';
+        while (! gzeof($handle)) {
+            $chunk = gzread($handle, 1024 * 1024);
+            if ($chunk === false) {
+                gzclose($handle);
+                throw new RuntimeException('The compressed legacy source file could not be read.');
+            }
+            $contents .= $chunk;
+            if (strlen($contents) > self::MAX_UNCOMPRESSED_BYTES) {
+                gzclose($handle);
+                throw new RuntimeException('The decompressed legacy source file is too large.');
+            }
+        }
+        gzclose($handle);
+
+        return $contents;
+    }
+
+    /** @return list<string> */
+    private function splitFields(string $input): array
+    {
+        $fields = [];
+        $buffer = '';
+        $quoted = false;
+        $escaped = false;
+        $length = strlen($input);
+        for ($index = 0; $index < $length; $index++) {
+            $character = $input[$index];
+            if ($escaped) {
+                $buffer .= $character;
+                $escaped = false;
+
+                continue;
+            }
+            if ($quoted && $character === '\\') {
+                $buffer .= $character;
+                $escaped = true;
+
+                continue;
+            }
+            if ($character === "'") {
+                $quoted = ! $quoted;
+                $buffer .= $character;
+
+                continue;
+            }
+            if (! $quoted && $character === ',') {
+                $fields[] = $buffer;
+                $buffer = '';
+
+                continue;
+            }
+            $buffer .= $character;
+        }
+        $fields[] = $buffer;
+
+        return $fields;
+    }
+
+    /** @return list<list<mixed>> */
+    private function parseRows(string $values): array
+    {
+        $rows = [];
+        $length = strlen($values);
+        $depth = 0;
+        $quoted = false;
+        $escaped = false;
+        $buffer = '';
+        for ($index = 0; $index < $length; $index++) {
+            $character = $values[$index];
+            if ($escaped) {
+                $buffer .= $character;
+                $escaped = false;
+
+                continue;
+            }
+            if ($quoted && $character === '\\') {
+                $buffer .= $character;
+                $escaped = true;
+
+                continue;
+            }
+            if ($character === "'") {
+                $quoted = ! $quoted;
+                if ($depth > 0) {
+                    $buffer .= $character;
+                }
+
+                continue;
+            }
+            if (! $quoted && $character === '(') {
+                $depth++;
+                if ($depth > 1) {
+                    $buffer .= $character;
+                }
+
+                continue;
+            }
+            if (! $quoted && $character === ')') {
+                $depth--;
+                if ($depth === 0) {
+                    $rows[] = array_map(fn (string $value): mixed => $this->literal($value), $this->splitFields($buffer));
+                    $buffer = '';
+                } elseif ($depth > 0) {
+                    $buffer .= $character;
+                }
+
+                continue;
+            }
+            if ($depth > 0) {
+                $buffer .= $character;
+            }
+        }
+
+        return $rows;
+    }
+
+    private function literal(string $value): mixed
+    {
+        $value = trim($value);
+        if (strcasecmp($value, 'NULL') === 0) {
+            return null;
+        }
+        if (strlen($value) >= 2 && $value[0] === "'" && $value[strlen($value) - 1] === "'") {
+            $value = substr($value, 1, -1);
+
+            return strtr($value, [
+                '\\0' => "\0", '\\n' => "\n", '\\r' => "\r", '\\Z' => "\x1a",
+                "\\'" => "'", '\\"' => '"', '\\\\' => '\\',
+            ]);
+        }
+        if (preg_match('/^-?\\d+$/', $value)) {
+            return (int) $value;
+        }
+        if (preg_match('/^-?\\d+\\.\\d+$/', $value)) {
+            return (float) $value;
+        }
+
+        return $value;
+    }
+}
diff --git a/app/Services/MigrationInvoiceExecutionService.php b/app/Services/MigrationInvoiceExecutionService.php
new file mode 100644
index 0000000..a343d87
--- /dev/null
+++ b/app/Services/MigrationInvoiceExecutionService.php
@@ -0,0 +1,207 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\Branch;
+use App\Models\Cashbox;
+use App\Models\DataMigrationMapping;
+use App\Models\DataMigrationRecord;
+use App\Models\DataMigrationRun;
+use App\Models\PaymentVoucher;
+use App\Models\PurchaseBill;
+use App\Models\Receipt;
+use App\Models\SalesBill;
+use App\Models\User;
+use App\Models\Warehouse;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+final class MigrationInvoiceExecutionService
+{
+    public function __construct(private readonly OperationsService $operations, private readonly AccountingService $accounting, private readonly CompanyAccountingPolicyService $policies) {}
+
+    /** @return array<string, int> */
+    public function execute(DataMigrationRun $run, User $actor): array
+    {
+        $this->assertReady($run);
+        $records = $run->records()->whereIn('status', [DataMigrationRecord::STATUS_READY, DataMigrationRecord::STATUS_FAILED])->orderBy('source_date')->orderBy('id')->get();
+        $counts = ['created' => 0, 'skipped' => 0, 'failed' => 0];
+        $company = $run->company()->firstOrFail();
+        if ($records->contains('entity_type', 'sales_document') && $this->policies->vatRate($company) > 0) {
+            throw ValidationException::withMessages(['execution' => 'Disable or map the target VAT policy before importing sales invoices; the legacy sales totals do not contain a separate VAT amount.']);
+        }
+
+        foreach ($records as $record) {
+            if ($record->status === DataMigrationRecord::STATUS_CREATED) {
+                $counts['skipped']++;
+
+                continue;
+            }
+            try {
+                $targetId = DB::transaction(function () use ($run, $record, $actor, $company): int {
+                    $record = DataMigrationRecord::query()->whereKey($record->id)->lockForUpdate()->firstOrFail();
+                    $payload = $record->normalized_payload ?? [];
+                    if ($record->entity_type === 'receipt_document') {
+                        $customer = $this->mappingTarget($run, 'customer', (string) ($payload['customer_source_id'] ?? ''));
+                        $cashbox = $this->cashbox($run, (string) ($payload['cashbox_source_id'] ?? ''));
+                        $receipt = $this->accounting->receive($company, $actor, ['counterparty_type' => 'customer', 'party_id' => $customer, 'cashbox_id' => $cashbox->id, 'receipt_date' => $payload['date'], 'amount' => $payload['amount'], 'notes' => 'Imported from legacy system. '.(string) ($payload['notes'] ?? '')]);
+                        $record->forceFill(['status' => DataMigrationRecord::STATUS_CREATED, 'target_type' => Receipt::class, 'target_id' => $receipt->id, 'error_message' => null])->save();
+
+                        return $receipt->id;
+                    }
+                    if ($record->entity_type === 'payment_document') {
+                        $supplier = $this->mappingTarget($run, 'supplier', (string) ($payload['supplier_source_id'] ?? ''));
+                        $cashbox = $this->cashbox($run, (string) ($payload['cashbox_source_id'] ?? ''));
+                        $voucher = $this->accounting->paySupplier($company, $actor, ['counterparty_type' => 'supplier', 'party_id' => $supplier, 'cashbox_id' => $cashbox->id, 'voucher_date' => $payload['date'], 'amount' => $payload['amount'], 'notes' => 'Imported from legacy system. '.(string) ($payload['notes'] ?? '')]);
+                        $record->forceFill(['status' => DataMigrationRecord::STATUS_CREATED, 'target_type' => PaymentVoucher::class, 'target_id' => $voucher->id, 'error_message' => null])->save();
+
+                        return $voucher->id;
+                    }
+                    $warehouse = $this->warehouse($run, (string) ($payload['warehouse_source_id'] ?? ''));
+                    $branch = Branch::query()->where('company_id', $company->id)->whereKey($warehouse->branch_id)->firstOrFail();
+                    $lines = $this->lines($run, $payload['lines'] ?? []);
+                    if ($record->entity_type === 'purchase_document') {
+                        $supplier = $this->mappingTarget($run, 'supplier', (string) ($payload['supplier_source_id'] ?? ''));
+                        $bill = $this->operations->savePurchase($company, $actor, $this->purchaseData($payload, $supplier, $warehouse, $branch, $lines), true);
+                        $record->forceFill(['status' => DataMigrationRecord::STATUS_CREATED, 'target_type' => PurchaseBill::class, 'target_id' => $bill->id, 'error_message' => null])->save();
+
+                        return $bill->id;
+                    }
+                    $customer = $this->mappingTarget($run, 'customer', (string) ($payload['customer_source_id'] ?? ''));
+                    $bill = $this->operations->saveSales($company, $actor, $this->salesData($payload, $customer, $warehouse, $branch, $lines), true);
+                    $record->forceFill(['status' => DataMigrationRecord::STATUS_CREATED, 'target_type' => SalesBill::class, 'target_id' => $bill->id, 'error_message' => null])->save();
+
+                    return $bill->id;
+                });
+                if ($targetId > 0) {
+                    $counts['created']++;
+                }
+            } catch (\Throwable $exception) {
+                $record->forceFill(['status' => DataMigrationRecord::STATUS_FAILED, 'error_message' => substr($exception->getMessage(), 0, 2000)])->save();
+                $counts['failed']++;
+            }
+        }
+
+        return $counts;
+    }
+
+    private function assertReady(DataMigrationRun $run): void
+    {
+        $unresolved = $run->records()->whereIn('status', [DataMigrationRecord::STATUS_READY, DataMigrationRecord::STATUS_FAILED])->get()->filter(function (DataMigrationRecord $record) use ($run): bool {
+            $payload = $record->normalized_payload ?? [];
+            $partyEntity = in_array($record->entity_type, ['purchase_document', 'payment_document'], true) ? 'supplier' : 'customer';
+            $partyKey = in_array($record->entity_type, ['purchase_document', 'payment_document'], true) ? ($payload['supplier_source_id'] ?? '') : ($payload['customer_source_id'] ?? '');
+            if (! $this->mappingTargetId($run, $partyEntity, (string) $partyKey)) {
+                return true;
+            }
+            if (in_array($record->entity_type, ['purchase_document', 'sales_document'], true) && ! $this->mappingTargetId($run, 'warehouse', (string) ($payload['warehouse_source_id'] ?? ''))) {
+                return true;
+            }
+            if (in_array($record->entity_type, ['receipt_document', 'payment_document'], true)) {
+                return ! $this->mappingTargetId($run, 'cashbox', (string) ($payload['cashbox_source_id'] ?? ''));
+            }
+            foreach ($payload['lines'] ?? [] as $line) {
+                if (! $this->mappingTargetId($run, 'product', (string) ($line['source_type_id'] ?? '').':'.(string) ($line['source_category_id'] ?? ''))) {
+                    return true;
+                }
+            }
+
+            return false;
+        });
+        if ($unresolved->isNotEmpty()) {
+            throw ValidationException::withMessages(['execution' => 'Every invoice, party, warehouse, and product mapping must be approved before execution.']);
+        }
+    }
+
+    private function mappingTarget(DataMigrationRun $run, string $entity, string $sourceKey): int
+    {
+        $target = $this->mappingTargetId($run, $entity, $sourceKey);
+        if (! $target) {
+            throw ValidationException::withMessages(['mapping' => "Missing approved {$entity} mapping for source {$sourceKey}."]);
+        }
+
+        return $target;
+    }
+
+    private function mappingTargetId(DataMigrationRun $run, string $entity, string $sourceKey): ?int
+    {
+        return DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', $entity)->where('source_key', $sourceKey)->where('decision', 'matched')->value('target_id');
+    }
+
+    private function warehouse(DataMigrationRun $run, string $sourceKey): Warehouse
+    {
+        return Warehouse::query()->where('company_id', $run->company_id)->findOrFail($this->mappingTarget($run, 'warehouse', $sourceKey));
+    }
+
+    private function cashbox(DataMigrationRun $run, string $sourceKey): Cashbox
+    {
+        return Cashbox::query()->where('company_id', $run->company_id)->where('is_active', true)->findOrFail($this->mappingTarget($run, 'cashbox', $sourceKey));
+    }
+
+    /** @param list<array<string, mixed>> $sourceLines @return list<array<string, mixed>> */
+    private function lines(DataMigrationRun $run, array $sourceLines): array
+    {
+        return array_map(function (array $line) use ($run): array {
+            return [
+                'product_id' => $this->mappingTarget($run, 'product', (string) ($line['source_type_id'] ?? '').':'.(string) ($line['source_category_id'] ?? '')),
+                'factory_weight' => $line['factory_weight'] ?? null,
+                'actual_weight' => $line['actual_weight'] ?? null,
+                'packages' => $line['packages'] ?? 0,
+                'unit_price' => $line['unit_price'] ?? 0,
+                'notes' => $line['notes'] ?? null,
+            ];
+        }, $sourceLines);
+    }
+
+    /** @param list<array<string, mixed>> $lines @return array<string, mixed> */
+    private function purchaseData(array $payload, int $supplier, Warehouse $warehouse, Branch $branch, array $lines): array
+    {
+        return [
+            'branch_id' => $branch->id,
+            'warehouse_id' => $warehouse->id,
+            'supplier_id' => $supplier,
+            'supplier_bill_number' => $payload['supplier_bill_number'],
+            'supplier_bill_date' => $payload['date'],
+            'warehouse_entry_date' => $payload['date'],
+            'total_factory_weight' => $payload['total_factory_weight'],
+            'total_actual_weight' => $payload['total_actual_weight'],
+            'total_packages' => $payload['total_packages'],
+            'transport_cost' => 0,
+            'loading_cost' => 0,
+            'extra_cost' => 0,
+            'discount' => 0,
+            'payment_method' => 'credit',
+            'notes' => $this->migrationNote($payload),
+            'lines' => $lines,
+        ];
+    }
+
+    /** @param list<array<string, mixed>> $lines @return array<string, mixed> */
+    private function salesData(array $payload, int $customer, Warehouse $warehouse, Branch $branch, array $lines): array
+    {
+        return [
+            'branch_id' => $branch->id,
+            'warehouse_id' => $warehouse->id,
+            'customer_id' => $customer,
+            'customer_bill_number' => $payload['customer_bill_number'],
+            'bill_date' => $payload['date'],
+            'total_actual_weight' => $payload['total_actual_weight'],
+            'total_packages' => $payload['total_packages'],
+            'transport_cost' => $payload['transport_cost'] ?? 0,
+            'loading_cost' => $payload['loading_cost'] ?? 0,
+            'extra_cost' => $payload['extra_cost'] ?? 0,
+            'discount' => 0,
+            'payment_method' => 'credit',
+            'due_date' => $payload['date'],
+            'notes' => $this->migrationNote($payload),
+            'lines' => $lines,
+        ];
+    }
+
+    private function migrationNote(array $payload): string
+    {
+        return trim('Imported from legacy system. '.(string) ($payload['legacy_note'] ?? ''));
+    }
+}
diff --git a/app/Services/MigrationMappingService.php b/app/Services/MigrationMappingService.php
new file mode 100644
index 0000000..e0df347
--- /dev/null
+++ b/app/Services/MigrationMappingService.php
@@ -0,0 +1,224 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\Bank;
+use App\Models\Cashbox;
+use App\Models\CustomerSupplier;
+use App\Models\DataMigrationMapping;
+use App\Models\DataMigrationRun;
+use App\Models\Diameter;
+use App\Models\Product;
+use App\Models\ProductType;
+use App\Models\Warehouse;
+use Carbon\CarbonImmutable;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+
+final class MigrationMappingService
+{
+    public function __construct(private readonly LegacySqlSnapshotParser $parser) {}
+
+    /** @return array<string, array<string, int>> */
+    public function suggest(DataMigrationRun $run): array
+    {
+        $snapshot = $this->parser->parse(Storage::disk($run->source_disk)->path($run->source_path));
+        $companyId = (int) $run->company_id;
+        $summary = [];
+
+        $summary['customers'] = $this->mapNamed($run, 'customer', 'customer', $snapshot['customer'], 'id_customer', 'name_customer', CustomerSupplier::query()->where('company_id', $companyId)->where('is_customer', true)->pluck('name', 'id')->all(), 'CustomerSupplier');
+        $summary['suppliers'] = $this->mapNamed($run, 'supplier', 'import', $snapshot['import'], 'id_import', 'name', CustomerSupplier::query()->where('company_id', $companyId)->where('is_supplier', true)->pluck('name', 'id')->all(), 'CustomerSupplier');
+        $summary['product_types'] = $this->mapNamed($run, 'product_type', 'type_mm', $snapshot['type_mm'], 'id_type', 'name', ProductType::query()->where('company_id', $companyId)->pluck('name', 'id')->all(), 'ProductType');
+        $summary['categories'] = $this->mapCategories($run, $snapshot['categories'], $companyId);
+        $summary['stores'] = $this->mapNamed($run, 'warehouse', 'stores', $snapshot['stores'], 'id_stores', 'name_stores', Warehouse::query()->where('company_id', $companyId)->pluck('name', 'id')->all(), 'Warehouse');
+        $summary['cashboxes'] = $this->mapNamed($run, 'cashbox', 'name_treasury', $snapshot['name_treasury'], 'id_name_treasury', 'name_treasury', Cashbox::query()->where('company_id', $companyId)->pluck('name', 'id')->all(), 'Cashbox');
+        $bankRows = collect($snapshot['bank_accounts'])->map(function (array $row) use ($snapshot): array {
+            $bank = collect($snapshot['name_bank'])->firstWhere('id_name_bank', $row['id_name_bank'] ?? null);
+            $row['display_name'] = trim((string) ($bank['name_bank'] ?? 'Bank').' / '.(string) ($row['account_number'] ?? ''));
+            $row['source_bank_name'] = $bank['name_bank'] ?? null;
+
+            return $row;
+        })->values()->all();
+        $bankTargets = Bank::query()->where('company_id', $companyId)->get(['id', 'name', 'account_number'])->mapWithKeys(fn (Bank $bank): array => [$bank->id => trim($bank->name.' / '.($bank->account_number ?? ''))])->all();
+        $summary['banks'] = $this->mapNamed($run, 'bank', 'bank_accounts', $bankRows, 'id_bank_accounts', 'display_name', $bankTargets, 'Bank');
+        $summary['products'] = $this->mapProducts($run, $snapshot, $companyId);
+
+        return $summary;
+    }
+
+    /** @param list<array<string, mixed>> $rows @param array<int|string, mixed> $targets @return array<string, int> */
+    private function mapNamed(DataMigrationRun $run, string $entity, string $sourceTable, array $rows, string $sourceKey, string $sourceName, array $targets, string $targetType): array
+    {
+        $normalizedTargets = [];
+        foreach ($targets as $id => $name) {
+            $normalizedTargets[$this->normalize((string) $name)] = (int) $id;
+        }
+        $counts = $this->emptyCounts();
+        foreach ($rows as $row) {
+            $key = (string) ($row[$sourceKey] ?? '');
+            $name = trim((string) ($row[$sourceName] ?? ''));
+            $targetId = $normalizedTargets[$this->normalize($name)] ?? null;
+            $decision = $targetId ? 'matched' : ($name === '' ? 'needs_review' : 'create_required');
+            $existing = $this->findMapping($run, $entity, $sourceTable, $key);
+            $reviewed = (bool) data_get($existing?->payload, 'reviewed', false);
+            if ($reviewed) {
+                $targetId = $existing->target_id;
+                $decision = $existing->decision;
+            }
+            $counts[$decision]++;
+            DataMigrationMapping::query()->updateOrCreate(
+                ['run_id' => $run->id, 'entity_type' => $entity, 'source_table' => $sourceTable, 'source_key' => $key],
+                ['target_type' => $targetType, 'target_id' => $targetId, 'decision' => $decision, 'confidence' => $targetId ? 1 : 0, 'payload' => ['source_name' => $name, 'normalized_name' => $this->normalize($name), 'source_attributes' => $this->sourceAttributes($row, $entity), 'reviewed' => $reviewed]],
+            );
+        }
+
+        return $counts;
+    }
+
+    /** @param list<array<string, mixed>> $rows @return array<string, int> */
+    private function mapCategories(DataMigrationRun $run, array $rows, int $companyId): array
+    {
+        $diameters = Diameter::query()->where('company_id', $companyId)->pluck('millimeters', 'id')->all();
+        $normalizedTargets = [];
+        foreach ($diameters as $id => $millimeters) {
+            $normalizedTargets[$this->normalizeNumber($millimeters)] = (int) $id;
+        }
+        $counts = $this->emptyCounts();
+        foreach ($rows as $row) {
+            $key = (string) ($row['id_categories'] ?? '');
+            $value = trim((string) ($row['categories'] ?? ''));
+            $numericValue = $this->diameterValue($value);
+            $normalized = $numericValue !== null ? $this->normalizeNumber($numericValue) : null;
+            $targetId = $normalized !== null ? ($normalizedTargets[$normalized] ?? null) : null;
+            $decision = $numericValue === null ? 'needs_review' : ($targetId ? 'matched' : 'create_required');
+            $existing = $this->findMapping($run, 'category', 'categories', $key);
+            $reviewed = (bool) data_get($existing?->payload, 'reviewed', false);
+            if ($reviewed) {
+                $targetId = $existing->target_id;
+                $decision = $existing->decision;
+            }
+            $counts[$decision]++;
+            DataMigrationMapping::query()->updateOrCreate(
+                ['run_id' => $run->id, 'entity_type' => 'category', 'source_table' => 'categories', 'source_key' => $key],
+                ['target_type' => $numericValue !== null ? 'Diameter' : null, 'target_id' => $targetId, 'decision' => $decision, 'confidence' => $targetId ? 1 : 0, 'payload' => ['source_value' => $value, 'source_kind' => $numericValue !== null ? 'diameter_candidate' : 'non_diameter_item', 'normalized_value' => $normalized, 'steel_or_other' => (int) ($row['steel_or_other'] ?? 1), 'reviewed' => $reviewed]],
+            );
+        }
+
+        return $counts;
+    }
+
+    /** @param array<string, list<array<string, mixed>>> $snapshot @return array<string, int> */
+    private function mapProducts(DataMigrationRun $run, array $snapshot, int $companyId): array
+    {
+        $types = collect($snapshot['type_mm'])->keyBy(fn (array $row): string => (string) ($row['id_type'] ?? ''));
+        $categories = collect($snapshot['categories'])->keyBy(fn (array $row): string => (string) ($row['id_categories'] ?? ''));
+        $buyParents = collect($snapshot['buy'])->filter(fn (array $row): bool => $this->inRange($row['date'] ?? null, $run->documents_from, $run->documents_to))->pluck('id_buy')->map(fn ($id): string => (string) $id);
+        $salesParents = collect($snapshot['sales'])->filter(fn (array $row): bool => $this->inRange($row['insert_date'] ?? null, $run->documents_from, $run->documents_to))->pluck('id_sales')->map(fn ($id): string => (string) $id);
+        $pairs = collect($snapshot['details_buy'])->filter(fn (array $row): bool => $buyParents->contains((string) ($row['id_buy'] ?? '')))->merge(collect($snapshot['details_sales'])->filter(fn (array $row): bool => $salesParents->contains((string) ($row['id_sales'] ?? ''))))->map(fn (array $row): string => (string) ($row['id_type'] ?? '').':'.(string) ($row['id_categories'] ?? ''))->unique()->values();
+        $typeMappings = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'product_type')->get()->keyBy('source_key');
+        $categoryMappings = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'category')->get()->keyBy('source_key');
+        $products = Product::query()->where('company_id', $companyId)->get(['id', 'name', 'product_type_id', 'diameter_id'])->keyBy('id');
+        $counts = $this->emptyCounts();
+
+        foreach ($pairs as $pair) {
+            [$typeId, $categoryId] = array_pad(explode(':', $pair, 2), 2, '');
+            $type = $types->get($typeId, []);
+            $category = $categories->get($categoryId, []);
+            $typeMapping = $typeMappings->get($typeId);
+            $categoryMapping = $categoryMappings->get($categoryId);
+            $typeName = trim((string) ($type['name'] ?? ''));
+            $categoryName = trim((string) ($category['categories'] ?? ''));
+            if ($typeName === '' || $categoryName === '' || ! $typeMapping) {
+                $counts['needs_review']++;
+
+                continue;
+            }
+            $numericCategory = $this->diameterValue($categoryName);
+            $targetTypeId = $typeMapping->target_id;
+            $targetDiameterId = $numericCategory !== null && $categoryMapping?->decision === 'matched' ? $categoryMapping->target_id : null;
+            $productName = $numericCategory !== null ? $typeName.' '.(float) $numericCategory.' mm' : $typeName.' / '.$categoryName;
+            $target = $products->first(function (Product $product) use ($targetTypeId, $targetDiameterId, $numericCategory, $productName): bool {
+                if ((int) $product->product_type_id !== (int) $targetTypeId) {
+                    return false;
+                }
+                if ($numericCategory !== null) {
+                    return (int) $product->diameter_id === (int) $targetDiameterId;
+                }
+
+                return $this->normalize((string) $product->name) === $this->normalize($productName);
+            });
+            $decision = $target ? 'matched' : ($typeMapping->decision === 'matched' && ($numericCategory === null || $categoryMapping?->decision === 'matched') ? 'create_required' : 'needs_review');
+            $existing = $this->findMapping($run, 'product', 'legacy_product', $pair);
+            $reviewed = (bool) data_get($existing?->payload, 'reviewed', false);
+            if ($reviewed) {
+                $target = $existing->target_id ? $products->get((int) $existing->target_id) : null;
+                $decision = $existing->decision;
+            }
+            $counts[$decision]++;
+            DataMigrationMapping::query()->updateOrCreate(
+                ['run_id' => $run->id, 'entity_type' => 'product', 'source_table' => 'legacy_product', 'source_key' => $pair],
+                ['target_type' => 'Product', 'target_id' => $target?->id, 'decision' => $decision, 'confidence' => $target ? 1 : 0, 'payload' => ['source_name' => $productName, 'source_attributes' => ['source_type_id' => $typeId, 'source_category_id' => $categoryId, 'type_name' => $typeName, 'category_name' => $categoryName, 'diameter_value' => $numericCategory, 'unit' => $numericCategory !== null ? 'ton' : null], 'reviewed' => $reviewed]],
+            );
+        }
+
+        return $counts;
+    }
+
+    /** @return array<string, int> */
+    private function emptyCounts(): array
+    {
+        return ['matched' => 0, 'needs_review' => 0, 'create_required' => 0];
+    }
+
+    private function findMapping(DataMigrationRun $run, string $entity, string $sourceTable, string $sourceKey): ?DataMigrationMapping
+    {
+        return DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', $entity)->where('source_table', $sourceTable)->where('source_key', $sourceKey)->first();
+    }
+
+    private function inRange(mixed $value, mixed $from, mixed $to): bool
+    {
+        if ($value === null || $from === null || $to === null) {
+            return false;
+        }
+        try {
+            return CarbonImmutable::parse((string) $value)->betweenIncluded(CarbonImmutable::parse((string) $from), CarbonImmutable::parse((string) $to));
+        } catch (\Throwable) {
+            return false;
+        }
+    }
+
+    private function diameterValue(string $value): ?float
+    {
+        if (! preg_match('/^\s*([0-9]+(?:\.[0-9]+)?)\s*(?:مم|mm)?\s*$/iu', $value, $matches)) {
+            return null;
+        }
+
+        return (float) $matches[1];
+    }
+
+    private function normalize(string $value): string
+    {
+        return Str::of($value)->lower()->squish()->toString();
+    }
+
+    /** @return array<string, mixed> */
+    private function sourceAttributes(array $row, string $entity): array
+    {
+        return match ($entity) {
+            'customer' => ['phone' => $row['phon'] ?? null, 'address' => $row['address'] ?? null, 'tax_number' => null],
+            'supplier' => ['phone' => null, 'address' => null, 'tax_number' => null],
+            'product_type' => ['kind' => ((int) ($row['steel_or_other'] ?? 1)) === 1 ? 'steel' : 'other'],
+            'warehouse' => ['address' => $row['address'] ?? null],
+            'cashbox' => [],
+            'bank' => ['bank_name' => $row['source_bank_name'] ?? $row['display_name'] ?? null, 'account_number' => $row['account_number'] ?? null],
+            default => [],
+        };
+    }
+
+    private function normalizeNumber(mixed $value): string
+    {
+        return rtrim(rtrim(number_format((float) $value, 2, '.', ''), '0'), '.');
+    }
+}
diff --git a/app/Services/MigrationMasterDataService.php b/app/Services/MigrationMasterDataService.php
new file mode 100644
index 0000000..e8ff3e8
--- /dev/null
+++ b/app/Services/MigrationMasterDataService.php
@@ -0,0 +1,149 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\Account;
+use App\Models\Branch;
+use App\Models\Company;
+use App\Models\DataMigrationMapping;
+use App\Models\DataMigrationRun;
+use App\Models\Diameter;
+use App\Models\Product;
+use App\Models\ProductType;
+use App\Models\User;
+use App\Models\Warehouse;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+final class MigrationMasterDataService
+{
+    public function __construct(private readonly AccountingService $accounting) {}
+
+    /** @return array<string, int> */
+    public function createApproved(DataMigrationRun $run, User $actor): array
+    {
+        $company = Company::query()->findOrFail($run->company_id);
+        $counts = ['customers' => 0, 'suppliers' => 0, 'product_types' => 0, 'diameters' => 0, 'warehouses' => 0];
+
+        DB::transaction(function () use ($run, $actor, $company, &$counts): void {
+            DataMigrationMapping::query()
+                ->where('run_id', $run->id)
+                ->where('decision', 'create_required')
+                ->lockForUpdate()
+                ->get()
+                ->each(function (DataMigrationMapping $mapping) use ($actor, $company, &$counts): void {
+                    $payload = $mapping->payload ?? [];
+                    $attributes = $payload['source_attributes'] ?? [];
+                    $name = trim((string) ($payload['source_name'] ?? ''));
+                    if ($name === '' && $mapping->entity_type !== 'category') {
+                        throw ValidationException::withMessages(['mapping' => 'A source name is required before creating master data.']);
+                    }
+
+                    [$targetId, $countKey] = match ($mapping->entity_type) {
+                        'customer' => [$this->createParty($company, $actor, $name, $attributes, true), 'customers'],
+                        'supplier' => [$this->createParty($company, $actor, $name, $attributes, false), 'suppliers'],
+                        'product_type' => [ProductType::query()->create(['company_id' => $company->id, 'name' => $name, 'kind' => $attributes['kind'] ?? 'other', 'status' => 'active'])->id, 'product_types'],
+                        'category' => [$this->createDiameter($company, (string) ($payload['source_value'] ?? '')), 'diameters'],
+                        'product' => [$this->createProduct($run, $company, $mapping, $name, $attributes), 'products'],
+                        'warehouse' => [$this->createWarehouse($company, $mapping, $name, $attributes), 'warehouses'],
+                        'cashbox' => [$this->createCashbox($company, $actor, $name), 'cashboxes'],
+                        'bank' => [$this->createBank($company, $actor, $attributes), 'banks'],
+                        default => throw ValidationException::withMessages(['mapping' => 'This mapping type cannot be created automatically.']),
+                    };
+                    $payload['reviewed'] = true;
+                    $mapping->forceFill(['target_id' => $targetId, 'decision' => 'matched', 'confidence' => 1, 'target_type' => class_basename($mapping->target_type ?? '') ?: null, 'payload' => $payload])->save();
+                    $counts[$countKey]++;
+                });
+        });
+
+        return $counts;
+    }
+
+    /** @param array<string, mixed> $attributes */
+    private function createParty(Company $company, User $actor, string $name, array $attributes, bool $customer): int
+    {
+        $parentCode = $customer ? '1.2' : '2.1';
+        $parent = Account::query()->where('company_id', $company->id)->where('code', $parentCode)->first();
+        if (! $parent) {
+            throw ValidationException::withMessages(['mapping' => "Target company is missing parent account {$parentCode}."]);
+        }
+        $party = $this->accounting->createParty($company, $actor, [
+            'parent_account_id' => $parent->id,
+            'name' => $name,
+            'phone' => $attributes['phone'] ?? null,
+            'address' => $attributes['address'] ?? null,
+            'tax_number' => $attributes['tax_number'] ?? null,
+            'is_customer' => $customer,
+            'is_supplier' => ! $customer,
+            'opening_balance' => 0,
+        ]);
+
+        return $party->id;
+    }
+
+    private function createDiameter(Company $company, string $value): int
+    {
+        if (! is_numeric($value) || (float) $value <= 0) {
+            throw ValidationException::withMessages(['mapping' => 'Only numeric categories can be created as diameters automatically.']);
+        }
+
+        return Diameter::query()->firstOrCreate(['company_id' => $company->id, 'millimeters' => (float) $value])->id;
+    }
+
+    /** @param array<string, mixed> $attributes */
+    private function createProduct(DataMigrationRun $run, Company $company, DataMigrationMapping $mapping, string $name, array $attributes): int
+    {
+        $typeMapping = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'product_type')->where('source_key', (string) ($attributes['source_type_id'] ?? ''))->first();
+        if (! $typeMapping?->target_id || $typeMapping->decision !== 'matched') {
+            throw ValidationException::withMessages(['mapping' => 'Approve the product type mapping before creating imported products.']);
+        }
+        $diameterId = null;
+        if (($attributes['diameter_value'] ?? null) !== null) {
+            $categoryMapping = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'category')->where('source_key', (string) ($attributes['source_category_id'] ?? ''))->first();
+            if (! $categoryMapping?->target_id || $categoryMapping->decision !== 'matched') {
+                throw ValidationException::withMessages(['mapping' => 'Approve the diameter mapping before creating imported steel products.']);
+            }
+            $diameterId = (int) $categoryMapping->target_id;
+        }
+        $sku = Str::limit('LEGACY-'.$run->id.'-'.$mapping->source_key, 76, '');
+        $unit = $attributes['unit'] ?? null;
+        if (! $unit) {
+            throw ValidationException::withMessages(['mapping' => "Choose a unit of measure before creating imported product {$name}."]);
+        }
+        $product = Product::query()->firstOrCreate(
+            ['company_id' => $company->id, 'sku' => $sku],
+            ['product_type_id' => (int) $typeMapping->target_id, 'diameter_id' => $diameterId, 'name' => $name, 'unit' => $unit, 'minimum_stock' => 0, 'status' => 'active'],
+        );
+
+        return $product->id;
+    }
+
+    private function createCashbox(Company $company, User $actor, string $name): int
+    {
+        return $this->accounting->createCashbox($company, $actor, $name)->id;
+    }
+
+    /** @param array<string, mixed> $attributes */
+    private function createBank(Company $company, User $actor, array $attributes): int
+    {
+        return $this->accounting->createBank($company, $actor, (string) ($attributes['bank_name'] ?? 'Imported bank'), $attributes['account_number'] ?? null)->id;
+    }
+
+    /** @param array<string, mixed> $attributes */
+    private function createWarehouse(Company $company, DataMigrationMapping $mapping, string $name, array $attributes): int
+    {
+        $branch = Branch::query()->where('company_id', $company->id)->where('status', 'active')->orderBy('id')->first();
+        if (! $branch) {
+            throw ValidationException::withMessages(['mapping' => 'Create an active branch before creating imported warehouses.']);
+        }
+        $warehouse = Warehouse::query()->firstOrCreate(
+            ['company_id' => $company->id, 'name' => $name],
+            ['branch_id' => $branch->id, 'code' => 'LEGACY-'.$mapping->source_key, 'details' => $attributes['address'] ?? null, 'status' => 'active'],
+        );
+
+        return $warehouse->id;
+    }
+}
diff --git a/app/Services/MigrationOpeningBalanceService.php b/app/Services/MigrationOpeningBalanceService.php
new file mode 100644
index 0000000..4911be0
--- /dev/null
+++ b/app/Services/MigrationOpeningBalanceService.php
@@ -0,0 +1,262 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\CustomerSupplier;
+use App\Models\DataMigrationMapping;
+use App\Models\DataMigrationRun;
+use App\Models\Product;
+use App\Models\StockBalance;
+use App\Models\StockMovement;
+use App\Models\User;
+use App\Models\Warehouse;
+use Carbon\CarbonImmutable;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+
+final class MigrationOpeningBalanceService
+{
+    public function __construct(private readonly LegacySqlSnapshotParser $parser, private readonly AccountingService $accounting) {}
+
+    /** @return array<string, mixed> */
+    public function post(DataMigrationRun $run, User $actor): array
+    {
+        $company = $run->company()->firstOrFail();
+        $snapshot = $this->parser->parse(Storage::disk($run->source_disk)->path($run->source_path));
+        $cutoff = CarbonImmutable::parse($run->opening_balance_as_of)->endOfDay();
+        $balances = $this->partyBalances($snapshot, $cutoff);
+        $stock = $this->stockBalances($snapshot, $cutoff);
+        $this->assertReadyForPosting($run, $balances, $stock);
+        $result = ['parties_posted' => 0, 'parties_zero' => 0, 'parties_skipped' => 0, 'stock_items_posted' => 0, 'stock_quantity' => 0.0, 'stock_value' => 0.0, 'warnings' => [...$balances['warnings'], ...$stock['warnings']]];
+
+        DB::transaction(function () use ($run, $actor, $company, $balances, $stock, &$result, $cutoff): void {
+            foreach ($balances['items'] as $item) {
+                $mapping = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', $item['entity'])->where('source_key', $item['source_key'])->where('decision', 'matched')->first();
+                if (! $mapping?->target_id) {
+                    $result['parties_skipped']++;
+                    $result['warnings'][] = "No approved {$item['entity']} mapping for opening balance source {$item['source_key']}.";
+
+                    continue;
+                }
+                $party = CustomerSupplier::query()->where('company_id', $company->id)->lockForUpdate()->find($mapping->target_id);
+                if (! $party) {
+                    throw ValidationException::withMessages(['opening' => "Opening balance target {$mapping->target_id} is outside the target company."]);
+                }
+                $amount = round(abs($item['balance']), 2);
+                if ($amount <= 0) {
+                    $result['parties_zero']++;
+
+                    continue;
+                }
+                if ($party->opening_balance_journal_entry_id || (float) $party->opening_balance > 0) {
+                    throw ValidationException::withMessages(['opening' => "Opening balance for target party {$party->id} already exists; it was not overwritten."]);
+                }
+                $customer = $item['entity'] === 'customer';
+                $direction = $customer ? ($item['balance'] >= 0 ? 'debit' : 'credit') : ($item['balance'] >= 0 ? 'credit' : 'debit');
+                $party->forceFill(['opening_balance' => $amount, 'opening_balance_direction' => $direction, 'opening_balance_date' => $cutoff->toDateString()])->save();
+                $this->accounting->postOpeningBalance($company, $actor, $party);
+                $result['parties_posted']++;
+            }
+
+            $inventoryValue = 0.0;
+            foreach ($stock['items'] as $item) {
+                $mapping = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'product')->where('source_key', $item['product_source_key'])->where('decision', 'matched')->first();
+                $warehouseMapping = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', 'warehouse')->where('source_key', $item['warehouse_source_key'])->where('decision', 'matched')->first();
+                if (! $mapping?->target_id || ! $warehouseMapping?->target_id) {
+                    throw ValidationException::withMessages(['opening' => "Opening stock mapping is incomplete for {$item['product_source_key']} / {$item['warehouse_source_key']}."]);
+                }
+                if ($item['quantity'] <= 0) {
+                    throw ValidationException::withMessages(['opening' => "Opening stock quantity is not positive for {$item['product_source_key']} / {$item['warehouse_source_key']}."]);
+                }
+                $product = Product::query()->where('company_id', $company->id)->find($mapping->target_id);
+                $warehouse = Warehouse::query()->where('company_id', $company->id)->find($warehouseMapping->target_id);
+                if (! $product || ! $warehouse) {
+                    throw ValidationException::withMessages(['opening' => "Opening stock target is outside the target company for {$item['product_source_key']}."]);
+                }
+                $sourceKey = 'opening:'.$run->id.':'.$warehouse->id.':'.$product->id;
+                if (StockMovement::query()->where('company_id', $company->id)->where('source_type', DataMigrationRun::class)->where('source_key', $sourceKey)->exists()) {
+                    continue;
+                }
+                $balance = StockBalance::query()->where('company_id', $company->id)->where('warehouse_id', $warehouse->id)->where('product_id', $product->id)->lockForUpdate()->first();
+                if (! $balance) {
+                    $balance = StockBalance::query()->create(['company_id' => $company->id, 'warehouse_id' => $warehouse->id, 'product_id' => $product->id, 'quantity' => 0, 'inventory_value' => 0, 'minimum_stock' => $product->minimum_stock ?? 0]);
+                    $balance = StockBalance::query()->whereKey($balance->id)->lockForUpdate()->firstOrFail();
+                }
+                if ((float) $balance->quantity !== 0.0 || (float) $balance->inventory_value !== 0.0) {
+                    throw ValidationException::withMessages(['opening' => "Target stock balance already exists for {$product->name} in {$warehouse->name}; opening stock was not merged automatically."]);
+                }
+                $value = round($item['quantity'] * $item['average_cost'], 2);
+                $balance->forceFill(['quantity' => round((float) $balance->quantity + $item['quantity'], 3), 'inventory_value' => round((float) $balance->inventory_value + $value, 2)])->save();
+                StockMovement::query()->create(['company_id' => $company->id, 'warehouse_id' => $warehouse->id, 'product_id' => $product->id, 'user_id' => $actor->id, 'movement_type' => 'opening_balance', 'quantity_delta' => $item['quantity'], 'value_delta' => $value, 'source_type' => DataMigrationRun::class, 'source_id' => $run->id, 'source_key' => $sourceKey, 'notes' => 'Imported opening stock as of '.$cutoff->toDateString()]);
+                $result['stock_items_posted']++;
+                $result['stock_quantity'] += $item['quantity'];
+                $inventoryValue += $value;
+            }
+            if ($inventoryValue > 0 && ! DB::table('journal_entries')->where('company_id', $company->id)->where('source_type', DataMigrationRun::class)->where('source_id', $run->id)->exists()) {
+                $inventory = app(AccountingFoundationService::class)->systemAccount($company, 'inventory_asset');
+                $equity = app(AccountingFoundationService::class)->systemAccount($company, 'opening_balance_equity');
+                $this->accounting->postOperationalJournal($company, $actor, $cutoff->toDateString(), 'Legacy opening inventory '.$run->source_name, DataMigrationRun::class, $run->id, [['account_id' => $inventory->id, 'debit' => round($inventoryValue, 2), 'credit' => 0, 'description' => 'Imported opening inventory'], ['account_id' => $equity->id, 'debit' => 0, 'credit' => round($inventoryValue, 2), 'description' => 'Opening inventory equity']]);
+            }
+            $result['stock_value'] = round($inventoryValue, 2);
+        });
+
+        return $result;
+    }
+
+    /** @return array{items:list<array<string,mixed>>,warnings:list<string>} */
+    private function partyBalances(array $snapshot, CarbonImmutable $cutoff): array
+    {
+        $items = [];
+        $warnings = [];
+        $totals = [];
+        $add = function (string $entity, string $sourceKey, float $amount) use (&$totals): void {
+            $key = $entity.'|'.$sourceKey;
+            $totals[$key] = ($totals[$key] ?? ['entity' => $entity, 'source_key' => $sourceKey, 'balance' => 0.0]);
+            $totals[$key]['balance'] += $amount;
+        };
+        $detailsBuy = collect($snapshot['details_buy'])->groupBy(fn (array $row): string => (string) ($row['id_buy'] ?? ''));
+        $detailsSales = collect($snapshot['details_sales'])->groupBy(fn (array $row): string => (string) ($row['id_sales'] ?? ''));
+        foreach ($snapshot['buy'] as $row) {
+            $date = $this->date($row['date'] ?? null);
+            if (! $date || $date->greaterThan($cutoff)) {
+                continue;
+            }
+            $sourceKey = (string) ($row['id_import'] ?? '');
+            if ($sourceKey === '') {
+                continue;
+            }
+            if ($this->isPaymentRow($row)) {
+                $add('supplier', $sourceKey, -1 * abs((float) ($row['eda3'] ?? 0)));
+
+                continue;
+            }
+            $amount = 0.0;
+            foreach ($detailsBuy->get((string) ($row['id_buy'] ?? ''), collect()) as $line) {
+                $amount += ((float) ($line['kg'] ?? 0) / 1000) * (float) ($line['price'] ?? 0);
+            }
+            $add('supplier', $sourceKey, $amount + (float) ($row['exp'] ?? 0));
+        }
+        foreach ($snapshot['sales'] as $row) {
+            $date = $this->date($row['insert_date'] ?? null);
+            if (! $date || $date->greaterThan($cutoff)) {
+                continue;
+            }
+            $sourceKey = (string) ($row['id_customer'] ?? '');
+            if ($sourceKey === '') {
+                continue;
+            }
+            if ($this->isPaymentRow($row)) {
+                $add('customer', $sourceKey, -1 * (float) ($row['cash'] ?? 0));
+
+                continue;
+            }
+            $amount = (float) ($row['total'] ?? 0);
+            if ($amount <= 0) {
+                foreach ($detailsSales->get((string) ($row['id_sales'] ?? ''), collect()) as $line) {
+                    $amount += (float) ($line['total'] ?? 0);
+                }
+                $amount += (float) ($row['tips'] ?? 0) + (float) ($row['mashal'] ?? 0);
+            }
+            $add('customer', $sourceKey, $amount);
+        }
+        foreach ($totals as $item) {
+            $items[] = $item;
+        }
+
+        return ['items' => $items, 'warnings' => $warnings];
+    }
+
+    /** @return array{items:list<array<string,mixed>>,warnings:list<string>} */
+    private function stockBalances(array $snapshot, CarbonImmutable $cutoff): array
+    {
+        $detailsBuy = collect($snapshot['details_buy'])->keyBy(fn (array $row): string => (string) ($row['id_details_buy'] ?? ''));
+        $detailsSales = collect($snapshot['details_sales'])->keyBy(fn (array $row): string => (string) ($row['id_details_sales'] ?? ''));
+        $buyDates = collect($snapshot['buy'])->keyBy(fn (array $row): string => (string) ($row['id_buy'] ?? ''));
+        $costs = [];
+        foreach ($snapshot['details_buy'] as $line) {
+            $buyHeader = $buyDates->get((string) ($line['id_buy'] ?? '')) ?? [];
+            $buyDate = $this->date($buyHeader['date'] ?? null);
+            if (! $buyDate || $buyDate->greaterThan($cutoff)) {
+                continue;
+            }
+            $qty = (float) ($line['kg'] ?? 0) / 1000;
+            $key = (string) ($line['id_type'] ?? '').':'.(string) ($line['id_categories'] ?? '');
+            $costs[$key]['qty'] = ($costs[$key]['qty'] ?? 0) + $qty;
+            $costs[$key]['value'] = ($costs[$key]['value'] ?? 0) + $qty * (float) ($line['price'] ?? 0);
+        }
+        $stock = [];
+        $warnings = [];
+        foreach ($snapshot['store'] as $row) {
+            $date = $this->date($row['date_add'] ?? null);
+            if (! $date || $date->greaterThan($cutoff)) {
+                continue;
+            }
+            $detail = ! empty($row['id_details_buy']) ? $detailsBuy->get((string) $row['id_details_buy']) : $detailsSales->get((string) ($row['id_details_sales'] ?? ''));
+            if (! $detail) {
+                continue;
+            }
+            $key = (string) ($detail['id_type'] ?? '').':'.(string) ($detail['id_categories'] ?? '');
+            $deltaKg = ! empty($row['buy']) ? (float) $row['buy'] : -1 * (float) ($row['sale'] ?? 0);
+            $compound = $key.'|'.(string) ($row['id_stores'] ?? '');
+            $stock[$compound] ??= ['product_source_key' => $key, 'warehouse_source_key' => (string) ($row['id_stores'] ?? ''), 'quantity' => 0.0, 'average_cost' => 0.0];
+            $stock[$compound]['quantity'] += $deltaKg / 1000;
+            $stock[$compound]['average_cost'] = ($costs[$key]['qty'] ?? 0) > 0 ? ($costs[$key]['value'] / $costs[$key]['qty']) : 0.0;
+        }
+        foreach ($stock as $item) {
+            if ($item['average_cost'] <= 0 && $item['quantity'] > 0) {
+                $warnings[] = "Opening stock {$item['product_source_key']} has no reliable purchase cost; it was not posted.";
+            }
+        }
+
+        return ['items' => array_values($stock), 'warnings' => $warnings];
+    }
+
+    /** @param array{items:list<array<string,mixed>>,warnings:list<string>} $balances @param array{items:list<array<string,mixed>>,warnings:list<string>} $stock */
+    private function assertReadyForPosting(DataMigrationRun $run, array $balances, array $stock): void
+    {
+        $errors = [];
+        foreach ($balances['items'] as $item) {
+            if (abs((float) $item['balance']) <= 0.01) {
+                continue;
+            }
+            $exists = DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', $item['entity'])->where('source_key', $item['source_key'])->where('decision', 'matched')->whereNotNull('target_id')->exists();
+            if (! $exists) {
+                $errors[] = "Missing approved {$item['entity']} mapping for opening balance source {$item['source_key']}.";
+            }
+        }
+        foreach ($stock['items'] as $item) {
+            if ((float) $item['quantity'] <= 0 || (float) $item['average_cost'] <= 0) {
+                $errors[] = "Opening stock requires a positive quantity and reliable cost for {$item['product_source_key']}.";
+
+                continue;
+            }
+            foreach ([['warehouse', $item['warehouse_source_key']], ['product', $item['product_source_key']]] as [$entity, $key]) {
+                if (! DataMigrationMapping::query()->where('run_id', $run->id)->where('entity_type', $entity)->where('source_key', $key)->where('decision', 'matched')->whereNotNull('target_id')->exists()) {
+                    $errors[] = "Missing approved {$entity} mapping for opening stock source {$key}.";
+                }
+            }
+        }
+        if ($errors !== []) {
+            throw ValidationException::withMessages(['opening' => array_slice($errors, 0, 20)]);
+        }
+    }
+
+    private function date(mixed $value): ?CarbonImmutable
+    {
+        if ($value === null || trim((string) $value) === '') {
+            return null;
+        }
+        try {
+            return CarbonImmutable::parse((string) $value)->endOfDay();
+        } catch (\Throwable) {
+            return null;
+        }
+    }
+
+    private function isPaymentRow(array $row): bool
+    {
+        return str_contains((string) ($row['bayan'] ?? ''), 'دفعة');
+    }
+}
diff --git a/app/Services/MigrationRecordStagingService.php b/app/Services/MigrationRecordStagingService.php
new file mode 100644
index 0000000..0cf2cc2
--- /dev/null
+++ b/app/Services/MigrationRecordStagingService.php
@@ -0,0 +1,242 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Models\DataMigrationRecord;
+use App\Models\DataMigrationRun;
+use Carbon\CarbonImmutable;
+use Carbon\CarbonInterface;
+use Illuminate\Support\Facades\Storage;
+
+final class MigrationRecordStagingService
+{
+    public function __construct(private readonly LegacySqlSnapshotParser $parser) {}
+
+    /** @return array<string, int> */
+    public function stage(DataMigrationRun $run): array
+    {
+        $snapshot = $this->parser->parse(Storage::disk($run->source_disk)->path($run->source_path));
+        $from = $run->documents_from->startOfDay();
+        $to = $run->documents_to->endOfDay();
+        $purchaseDetails = collect($snapshot['details_buy'])->groupBy(fn (array $row): string => (string) ($row['id_buy'] ?? ''));
+        $salesDetails = collect($snapshot['details_sales'])->groupBy(fn (array $row): string => (string) ($row['id_sales'] ?? ''));
+        $counts = ['ready' => 0, 'needs_review' => 0];
+
+        foreach ($snapshot['buy'] as $row) {
+            if (! $this->inRange($row['date'] ?? null, $from, $to)) {
+                continue;
+            }
+            if ($this->isPaymentRow($row)) {
+                continue;
+            }
+            $id = (string) ($row['id_buy'] ?? '');
+            $details = $purchaseDetails->get($id, collect())->values()->all();
+            $ready = $details !== [] && ! empty($row['id_import']) && ! empty($row['id_stores']) && ! empty($row['id_type']);
+            $this->upsert($run, 'purchase_document', 'buy', $id, $row['date'] ?? null, 'legacy-buy-'.$id, $row, $this->normalizePurchase($row, $details), $ready);
+            $counts[$ready ? 'ready' : 'needs_review']++;
+        }
+
+        foreach ($snapshot['sales'] as $row) {
+            if (! $this->inRange($row['insert_date'] ?? null, $from, $to)) {
+                continue;
+            }
+            if ($this->isPaymentRow($row)) {
+                continue;
+            }
+            $id = (string) ($row['id_sales'] ?? '');
+            $details = $salesDetails->get($id, collect())->values()->all();
+            $normalized = $this->normalizeSales($row, $details);
+            $calculatedTotal = round((float) $normalized['subtotal'] + (float) $normalized['transport_cost'] + (float) $normalized['loading_cost'], 2);
+            $ready = $details !== [] && ! empty($row['id_customer']) && ! empty($row['id_stores']) && abs((float) $normalized['legacy_total'] - $calculatedTotal) < 0.01;
+            $this->upsert($run, 'sales_document', 'sales', $id, $row['insert_date'] ?? null, 'legacy-sales-'.$id, $row, $normalized, $ready);
+            $counts[$ready ? 'ready' : 'needs_review']++;
+        }
+
+        $counts = [...$counts, ...$this->stagePayments($run, $snapshot, $from, $to), ...$this->stageExpenses($run, $snapshot, $from, $to)];
+
+        return $counts;
+    }
+
+    /** @param array<string, list<array<string, mixed>>> $snapshot @return array<string, int> */
+    private function stagePayments(DataMigrationRun $run, array $snapshot, CarbonInterface $from, CarbonInterface $to): array
+    {
+        $counts = ['receipts_ready' => 0, 'receipts_needs_review' => 0, 'payments_ready' => 0, 'payments_needs_review' => 0];
+        $treasury = collect($snapshot['treasury'])->keyBy(fn (array $row): string => (string) ($row['id_treasury'] ?? ''));
+        foreach ($snapshot['sales'] as $row) {
+            if (! $this->isPaymentRow($row) || ! $this->inRange($row['insert_date'] ?? null, $from, $to)) {
+                continue;
+            }
+            $amount = (float) ($row['cash'] ?? 0);
+            $treasuryRow = $treasury->get((string) ($row['id_cash'] ?? ''));
+            $sourceKey = (string) ($treasuryRow['id_name_treasury'] ?? $row['id_cash'] ?? '');
+            $ready = $amount > 0 && ! empty($row['id_customer']) && $sourceKey !== '';
+            $normalized = ['payment_type' => 'receipt', 'customer_source_id' => (string) ($row['id_customer'] ?? ''), 'cashbox_source_id' => $sourceKey, 'amount' => abs($amount), 'date' => $row['insert_date'] ?? null, 'notes' => $row['bayan'] ?? null, 'allocation_source_id' => $row['id_sales'] ?? null];
+            $this->upsert($run, 'receipt_document', 'sales', (string) ($row['id_sales'] ?? ''), $row['insert_date'] ?? null, 'legacy-receipt-'.($row['id_sales'] ?? ''), $row, $normalized, $ready);
+            $counts[$ready ? 'receipts_ready' : 'receipts_needs_review']++;
+        }
+        foreach ($snapshot['buy'] as $row) {
+            if (! $this->isPaymentRow($row) || ! $this->inRange($row['date'] ?? null, $from, $to)) {
+                continue;
+            }
+            $amount = (float) ($row['eda3'] ?? 0);
+            $treasuryRow = $treasury->get((string) ($row['id_eda3at'] ?? ''));
+            $sourceKey = (string) ($treasuryRow['id_name_treasury'] ?? $row['id_eda3at'] ?? '');
+            $ready = $amount > 0 && ! empty($row['id_import']) && $sourceKey !== '';
+            $normalized = ['payment_type' => 'payment', 'supplier_source_id' => (string) ($row['id_import'] ?? ''), 'cashbox_source_id' => $sourceKey, 'amount' => abs($amount), 'date' => $row['date'] ?? null, 'notes' => $row['bayan'] ?? null, 'allocation_source_id' => $row['id_buy'] ?? null];
+            $this->upsert($run, 'payment_document', 'buy', (string) ($row['id_buy'] ?? ''), $row['date'] ?? null, 'legacy-payment-'.($row['id_buy'] ?? ''), $row, $normalized, $ready);
+            $counts[$ready ? 'payments_ready' : 'payments_needs_review']++;
+        }
+
+        return $counts;
+    }
+
+    private function isPaymentRow(array $row): bool
+    {
+        return str_contains((string) ($row['bayan'] ?? ''), 'دفعة');
+    }
+
+    /** @param array<string, list<array<string, mixed>>> $snapshot @return array<string, int> */
+    private function stageExpenses(DataMigrationRun $run, array $snapshot, CarbonInterface $from, CarbonInterface $to): array
+    {
+        $count = 0;
+        foreach ($snapshot['all_expenses'] as $row) {
+            if (! $this->inRange($row['insert_date'] ?? null, $from, $to)) {
+                continue;
+            }
+            $sourceId = (string) ($row['id_all_expenses'] ?? '');
+            $payload = ['amount' => (float) ($row['amount'] ?? 0), 'date' => $row['insert_date'] ?? null, 'description' => $row['bayan'] ?? null, 'legacy_expense_id' => $row['id_expenses'] ?? null, 'legacy_category_id' => $row['id_category_expenses'] ?? null, 'legacy_vehicle_id' => $row['id_car'] ?? null, 'requires_account_review' => true];
+            $this->upsert($run, 'expense_document', 'all_expenses', $sourceId, $row['insert_date'] ?? null, 'legacy-expense-'.$sourceId, $row, $payload, false);
+            $count++;
+        }
+
+        return ['expense_needs_review' => $count];
+    }
+
+    /** @param list<array<string, mixed>> $rows @return array<string, mixed> */
+    private function normalizePurchase(array $header, array $rows): array
+    {
+        $lines = array_map(fn (array $row): array => $this->normalizeLine($row, false), $rows);
+        $factoryWeight = array_sum(array_column($lines, 'quantity_ton'));
+        $packages = array_sum(array_column($lines, 'packages'));
+        $subtotal = array_sum(array_column($lines, 'line_total'));
+
+        return [
+            'source_document_type' => 'purchase',
+            'supplier_source_id' => (string) ($header['id_import'] ?? ''),
+            'warehouse_source_id' => (string) ($header['id_stores'] ?? ''),
+            'supplier_bill_number' => 'LEGACY-PB-'.($header['id_buy'] ?? ''),
+            'date' => $header['date'] ?? null,
+            'total_factory_weight' => round($factoryWeight, 3),
+            'total_actual_weight' => round($factoryWeight, 3),
+            'total_packages' => round($packages, 3),
+            'subtotal' => round($subtotal, 2),
+            'transport_cost' => 0,
+            'loading_cost' => 0,
+            'extra_cost' => 0,
+            'discount' => 0,
+            'payment_method' => 'credit',
+            'lines' => $lines,
+            'legacy_note' => $header['bayan'] ?? null,
+        ];
+    }
+
+    /** @param list<array<string, mixed>> $rows @return array<string, mixed> */
+    private function normalizeSales(array $header, array $rows): array
+    {
+        $lines = array_map(fn (array $row): array => $this->normalizeLine($row, true), $rows);
+        $headerPackages = (float) ($header['numper'] ?? 0);
+        if ($headerPackages > 0 && $lines !== []) {
+            $lines[array_key_last($lines)]['packages'] = $headerPackages;
+            $lines[array_key_last($lines)]['packages_source_scope'] = 'header';
+        }
+        $actualWeight = array_sum(array_column($lines, 'quantity_ton'));
+        $packages = array_sum(array_column($lines, 'packages'));
+        $transport = (float) ($header['tips'] ?? 0);
+        $loading = (float) ($header['mashal'] ?? 0);
+
+        return [
+            'source_document_type' => 'sales',
+            'customer_source_id' => (string) ($header['id_customer'] ?? ''),
+            'warehouse_source_id' => (string) ($header['id_stores'] ?? ''),
+            'customer_bill_number' => 'LEGACY-SB-'.($header['id_sales'] ?? ''),
+            'date' => $header['insert_date'] ?? null,
+            'total_actual_weight' => round($actualWeight, 3),
+            'total_packages' => round($packages, 3),
+            'subtotal' => round(array_sum(array_column($lines, 'line_total')), 2),
+            'transport_cost' => round($transport, 2),
+            'loading_cost' => round($loading, 2),
+            'extra_cost' => 0,
+            'discount' => 0,
+            'payment_method' => 'credit',
+            'legacy_total' => (float) ($header['total'] ?? 0),
+            'lines' => $lines,
+            'legacy_note' => $header['bayan'] ?? null,
+        ];
+    }
+
+    /** @param array<string, mixed> $row @return array<string, mixed> */
+    private function normalizeLine(array $row, bool $sales): array
+    {
+        $quantityKg = (float) ($row['kg'] ?? 0);
+        $quantityTon = round($quantityKg / 1000, 3);
+        $unitPrice = (float) ($row['price'] ?? 0);
+        $sourceTotal = $sales ? (float) ($row['total'] ?? 0) : 0;
+        $lineTotal = $sourceTotal > 0 ? round($sourceTotal, 2) : round($quantityTon * $unitPrice, 2);
+
+        return [
+            'source_line_id' => $row[$sales ? 'id_details_sales' : 'id_details_buy'] ?? null,
+            'source_type_id' => (string) ($row['id_type'] ?? ''),
+            'source_category_id' => (string) ($row['id_categories'] ?? ''),
+            'source_warehouse_id' => (string) ($row['id_stores'] ?? ''),
+            'quantity_kg' => $quantityKg,
+            'quantity_ton' => $quantityTon,
+            'factory_weight' => $sales ? null : $quantityTon,
+            'actual_weight' => $sales ? $quantityTon : $quantityTon,
+            'packages' => (float) ($row['no'] ?? 0),
+            'unit_price' => $unitPrice,
+            'line_total' => $lineTotal,
+            'notes' => $row['note'] ?? null,
+        ];
+    }
+
+    private function inRange(mixed $value, CarbonInterface $from, CarbonInterface $to): bool
+    {
+        if ($value === null || trim((string) $value) === '') {
+            return false;
+        }
+        try {
+            $date = CarbonImmutable::parse((string) $value);
+        } catch (\Throwable) {
+            return false;
+        }
+
+        return $date->betweenIncluded($from, $to);
+    }
+
+    /** @param array<string, mixed> $header @param array<string, mixed> $normalized */
+    private function upsert(DataMigrationRun $run, string $entity, string $sourceTable, string $sourceId, mixed $date, string $sourceNumber, array $header, array $normalized, bool $ready): void
+    {
+        $targetType = match ($entity) {
+            'purchase_document' => 'PurchaseBill',
+            'sales_document' => 'SalesBill',
+            'receipt_document' => 'Receipt',
+            'payment_document' => 'PaymentVoucher',
+            default => null,
+        };
+        DataMigrationRecord::query()->updateOrCreate(
+            ['run_id' => $run->id, 'entity_type' => $entity, 'source_table' => $sourceTable, 'source_id' => $sourceId],
+            [
+                'source_date' => $date,
+                'source_number' => $sourceNumber,
+                'source_payload' => ['header' => $header, 'normalized' => $normalized],
+                'normalized_payload' => ['source_document_type' => $entity, 'source_id' => $sourceId, 'classification' => $ready ? ($targetType ? 'financial_document_candidate' : 'needs_review') : 'needs_review', ...$normalized],
+                'status' => $ready ? DataMigrationRecord::STATUS_READY : DataMigrationRecord::STATUS_NEEDS_REVIEW,
+                'target_type' => $ready ? $targetType : null,
+                'fingerprint' => hash('sha256', implode('|', [$run->company_id, $run->source_system, $sourceTable, $sourceId])),
+                'error_message' => null,
+            ],
+        );
+    }
+}
