+++ b/simple-party-import-results-ar.md
@@ -0,0 +1,17 @@
+# نتيجة تنفيذ الاستيراد المبسط
+
+تم بناء مسار مستقل لاستيراد أسماء العملاء والموردين وأرصدة حساباتهم حتى تاريخ قطع يحدده الملف. المسار لا يحلل SQL ولا يقرأ قاعدة البيانات القديمة ولا ينقل فواتير أو مخزونًا أو سندات.
+
+تظهر بطاقة الاستيراد داخل صفحة **العملاء والموردين** للمستخدم الذي يملك صلاحية إنشاء الأطراف. يمكنه تحميل نموذج JSON، تجهيز الملف من البرنامج القديم، ثم رفعه والضغط على **استيراد مباشر**.
+
+يتحقق النظام من صحة JSON، الإصدار، التاريخ، نوع الطرف، اتجاه الرصيد، عدم سلبية المبلغ، حجم الملف، وتكرار الأسماء داخل الملف. تتم العملية في معاملة واحدة؛ فإذا فشل أي صف لا تُحفظ صفوف جزئية. الأسماء الموجودة مسبقًا لا تُعدّل ولا تُنشأ لها قيود جديدة، بل تظهر في نتيجة العملية كسجلات متخطاة.
+
+يُنشأ العميل تحت حساب العملاء النظامي، والمورد تحت حساب الموردين النظامي. ويُستخدم منطق `AccountingService` الحالي لإنشاء الحساب الفرعي والقيد الافتتاحي المتوازن مقابل حساب أرصدة البداية. إذا كان تاريخ القطع 30 سبتمبر، يكون تاريخ القيد الافتتاحي 1 أكتوبر تلقائيًا.
+
+## التحقق
+
+نجح اختبار الاستيراد المباشر في إنشاء عميل ومورد مع قيدين متوازنين، وإعادة رفع نفس الملف دون تكرار، ورفض ملف غير صالح دون حفظ جزئي. نجح اختبار PHPUnit المباشر: 3 اختبارات و16 assertion. نجح اختبار المشروع الكامل: 21 مجموعة اختبار، 3286 assertion، دون فشل. نجح بناء Vite و`git diff --check` وPint على الملفات المتأثرة.
+
+## ملاحظة عن مركز النقل القديم
+
+لم يتم حذف كود مركز النقل SQL القديم من المستودع في هذه المرحلة حتى لا يؤدي الحذف إلى كسر ترحيلات قاعدة البيانات أو الاختبارات أو مسارات الإدارة القديمة. مسار الاستيراد الجديد مستقل ولا يستخدمه. يمكن في خطوة لاحقة إخفاء رابط المركز القديم أو حذفه بعد التأكد من عدم وجود حاجة للبيانات التاريخية أو لمساراته الحالية.
diff --git a/tests/Feature/SimplePartyImportTest.php b/tests/Feature/SimplePartyImportTest.php
new file mode 100644
index 0000000..421c6a3
--- /dev/null
+++ b/tests/Feature/SimplePartyImportTest.php
@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Feature;
+
+use App\Models\Company;
+use App\Models\CustomerSupplier;
+use App\Models\JournalEntry;
+use App\Models\User;
+use App\Services\SimplePartyImportService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+final class SimplePartyImportTest extends TestCase
+{
+    use RefreshDatabase;
+
+    /** @var list<string> */
+    private array $temporaryFiles = [];
+
+    protected function tearDown(): void
+    {
+        foreach ($this->temporaryFiles as $path) {
+            @unlink($path);
+        }
+        parent::tearDown();
+    }
+
+    public function test_it_imports_customers_and_suppliers_with_balanced_opening_entries(): void
+    {
+        [$company, $actor] = $this->companyAndActor();
+        $result = app(SimplePartyImportService::class)->import($company, $actor, $this->file([
+            'schema_version' => 1,
+            'cutoff_date' => '2026-09-30',
+            'parties' => [
+                ['name' => 'Imported Customer', 'type' => 'customer', 'opening_balance' => 1250, 'opening_balance_direction' => 'debit'],
+                ['name' => 'Imported Supplier', 'type' => 'supplier', 'opening_balance' => 830, 'opening_balance_direction' => 'credit'],
+            ],
+        ]));
+
+        $this->assertSame(2, $result['created']);
+        $this->assertSame('2026-10-01', $result['effective_date']);
+        $customer = CustomerSupplier::query()->where('company_id', $company->id)->where('name', 'Imported Customer')->firstOrFail();
+        $supplier = CustomerSupplier::query()->where('company_id', $company->id)->where('name', 'Imported Supplier')->firstOrFail();
+        $this->assertSame('2026-10-01', $customer->opening_balance_date->toDateString());
+        $this->assertSame('2026-10-01', $supplier->opening_balance_date->toDateString());
+        $this->assertSame('debit', $customer->opening_balance_direction);
+        $this->assertSame('credit', $supplier->opening_balance_direction);
+        $this->assertSame(2, JournalEntry::query()->where('company_id', $company->id)->count());
+        $totals = DB::table('journal_lines')->where('company_id', $company->id)->selectRaw('SUM(debit) as debit, SUM(credit) as credit')->first();
+        $this->assertEqualsWithDelta((float) $totals->debit, (float) $totals->credit, 0.001);
+    }
+
+    public function test_existing_names_are_skipped_and_reimport_is_idempotent(): void
+    {
+        [$company, $actor] = $this->companyAndActor();
+        $importer = app(SimplePartyImportService::class);
+        $payload = ['schema_version' => 1, 'cutoff_date' => '2026-09-30', 'parties' => [['name' => 'Repeat Customer', 'type' => 'customer', 'opening_balance' => 100, 'opening_balance_direction' => 'debit']]];
+
+        $first = $importer->import($company, $actor, $this->file($payload));
+        $second = $importer->import($company, $actor, $this->file($payload));
+
+        $this->assertSame(1, $first['created']);
+        $this->assertSame(0, $second['created']);
+        $this->assertSame(1, $second['skipped']);
+        $this->assertSame(1, CustomerSupplier::query()->where('company_id', $company->id)->where('name', 'Repeat Customer')->count());
